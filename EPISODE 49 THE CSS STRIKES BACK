:root{
    --movie-gold: #e5b13a;
}
body{
    background-color: black;
    overflow: hidden;
    color: aliceblue;
}
#cinema-screen{
     display: flex;
     justify-content: center;
      height: 100vh;
       perspective: 400px;
}
 @keyframes epic-scroll{ 
0%{
transform:rotateX(25deg) translateY(100%);
}
100%{
transform: rotateX(25deg)translateY(-200%);
}
 }
 #crawl-container{
color:var(--movie-gold);
 animation: epic-scroll
15s linear infinite;
 }
